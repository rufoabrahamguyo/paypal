# ---------------------------------------------------------------------------
# Funguo configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- PayPal (REQUIRED, sandbox only) ---------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" (default) talks to api-m.sandbox.paypal.com.
# "simulate" runs an in-process PayPal stand-in so you can click through with
# no credentials at all. The UI shows a banner whenever simulate is active.
PAYPAL_MODE=sandbox
# Optional: webhook id from the sandbox app, enables signature verification.
PAYPAL_WEBHOOK_ID=

# --- Anthropic (dispute agent) ----------------------------------------------
# console.anthropic.com -> API Keys. Without it, disputes fall back to a
# clearly-labelled deterministic rule engine instead of Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Decisions with confidence below this are escalated to a human, not executed.
AGENT_MIN_CONFIDENCE=0.7

# --- Sponsor integrations (optional; seeded fallbacks are used when empty) --
# Channel3 product data: trychannel3.com (free key, 1k searches/month)
CHANNEL3_API_KEY=
# Elastic Cloud: deployment endpoint + API key. Empty -> local cosine search.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=funguo-scam-patterns

# --- App --------------------------------------------------------------------
PORT=3000
# Public base URL used for PayPal return/cancel URLs. Defaults to
# http://localhost:$PORT locally and RENDER_EXTERNAL_URL on Render.
BASE_URL=
DB_PATH=./data/funguo.db
# Hours PayPal guarantees an authorization (honor period). After this, wallet
# holds are reauthorized automatically. Lower it only to test reauthorization.
HONOR_PERIOD_HOURS=72
# Platform fee in basis points (stubbed: computed + recorded, not disbursed).
PLATFORM_FEE_BPS=250
