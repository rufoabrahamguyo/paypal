{
  "name": "funguo",
  "version": "0.1.0",
  "description": "Escrow on PayPal for social commerce and AI shopping agents, with a Claude dispute adjudicator",
  "type": "module",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"BASE_URL=${BASE_URL:-http://localhost:${WEB_PORT:-5180}} node --watch backend/server.js\" \"vite --config web/vite.config.js\"",
    "start": "node backend/scripts/seed.js --if-empty && node backend/server.js",
    "seed": "node backend/scripts/seed.js",
    "agent-buyer": "node backend/scripts/agent-buyer.js",
    "test:paypal": "node backend/scripts/paypal-smoke.js",
    "mcp": "node backend/mcp.js",
    "build": "vite build --config web/vite.config.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.4.5"
  }
}
